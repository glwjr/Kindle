# ==========================================
# Unreal Engine & IDE GitIgnore Configuration
# ==========================================

# IDE and Project files (Safe to ignore: Unreal can re-generate these)
.vs/
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Compiled Object & Engine Binaries
Binaries/*
Plugins/**/Binaries/*
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.lib
*.exe
*.out
*.app
*.ipa

# Unreal Engine Temp, Cache, and Local Folders
DerivedDataCache/*
Intermediate/*
Plugins/**/Intermediate/*
Saved/*

# Ignore local configuration overrides
Saved/Config/Windows/*.ini
Saved/Config/WindowsNoEditor/*.ini

# Ignore automatic crash reports and trace data
Saved/Crashes/
Saved/Logs/
Saved/Profiling/

# Ignore local source control state/history
.idea/
.vscode/

# Project Builds
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Optional: Map built data (uncomment if you want to regenerate lighting locally per dev)
# *_BuiltData.uasset
